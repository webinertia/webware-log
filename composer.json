{
    "name": "webware/webware-log",
    "description": "Webware Logging component",
    "license": "BSD-3-Clause",
    "keywords": [
        "webware",
        "mezzio",
        "laminas",
        "psr 3",
        "monolog"
    ],
    "authors": [
        {
            "name": "Joey Smith",
            "email": "jsmith@webinertia.net"
        }
    ],
    "homepage": "https://github.com/orgs/webinertia/webware-log/discussions",
    "support": {
        "issues": "https://github.com/webinertia/webware-log/issues",
        "chat": "https://discord.gg/89DfgmuF6C"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.99"
        },
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "infection/extension-installer": true,
            "laminas/laminas-component-installer": true
        }
    },
    "require": {
        "php": "~8.4.1 || ~8.5.0",
        "laminas/laminas-hydrator": "^4.15.0",
        "laminas/laminas-component-installer": "^3.2",
        "monolog/monolog": "^3.4",
        "phly/phly-event-dispatcher": "^1.5.0",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "infection/infection": "^0.35.0",
        "laminas/laminas-diactoros": "^3.5",
        "laminas/laminas-i18n": "^3.0",
        "laminas/laminas-servicemanager": "^3.23.0 || ^4.0.0",
        "mezzio/mezzio": "^3.26",
        "mezzio/mezzio-authentication": "^1.13",
        "php-db/phpdb-mysql": "0.5.x-dev",
        "php-standard-library/type": "^6.2",
        "phpbench/phpbench": "^1.7",
        "phpunit/phpunit": "^13.3.0",
        "roave/backward-compatibility-check": "^8.21.0",
        "roave/security-advisories": "dev-master",
        "webware/webware-tools": "^1.0.0-beta"
    },
    "suggest": {
        "php-db/phpdb-mysql": "Required when using PhpDbHandler with a MySQL/MariaDB database"
    },
    "extra": {
        "laminas": {
            "component": "Webware\\Log",
            "config-provider": "Webware\\Log\\ConfigProvider"
        }
    },
    "autoload": {
        "psr-4": {
            "Webware\\Log\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebwareTest\\Log\\": "test/unit/",
            "WebwareTestIntegration\\Log\\": "test/integration/"
        }
    },
    "scripts": {
        "test-all": [
            "@test",
            "@test-integration",
            "@mutation-test"
        ],
        "test": "phpunit --no-coverage --colors=always --testsuite \"unit test\"",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml --coverage-html coverage/html --coverage-text",
        "test-integration": "phpunit --no-coverage --colors=always --testsuite \"integration test\"",
        "mutation-test": "infection"
    }
}
